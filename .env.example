DISCORD_TOKEN=
ADMIN_GUILD_ID=
DATABASE_URL=sqlite+aiosqlite:////app/data/helzer.db
DOCKER_HOST=unix:///var/run/docker.sock

# Optional AI planner for the VPS bot's own admin tools.
AI_ENDPOINT=https://api.openai.com/v1/chat/completions
AI_MODEL=
AI_API_KEY=

# Comma-separated Discord user IDs allowed to use /admin commands.
ADMIN_USER_IDS=

# Private agent API consumed by HelzerX AI Ticket Manager.
AGENT_API_HOST=127.0.0.1
AGENT_API_PORT=8787
AGENT_API_TOKEN=replace-with-a-long-random-secret
